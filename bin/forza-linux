#!/usr/bin/env bash

set -u

service_name=xodus-forza.service
systemctl_bin=${FORZA_SYSTEMCTL:-systemctl}
runtime_dir=${XDG_RUNTIME_DIR:-}
started_here=0
started_invocation_id=
started_owner_token=
reservation_token=
game_pid=
wait_timer_pid=

service_is_active() {
    "$systemctl_bin" --user is-active --quiet "$service_name"
}

service_is_inactive() {
    service_is_active
    [[ $? -eq 3 ]]
}

service_invocation_id() {
    "$systemctl_bin" --user show --property=InvocationID --value "$service_name"
}

token_file_matches() {
    local path=$1 expected=$2
    [[ -f $path && ! -L $path && $(stat -c %a -- "$path") == 600 && $(<"$path") == "$expected" ]]
}

socket_is_listening() {
    awk -v path="$socket_path" '
        $4 == "00010000" && $5 == "0001" && $6 == "01" && \
            $8 == path {
            found = 1
        }
        END { exit !found }
    ' /proc/net/unix
}

stop_wait_timer() {
    if [[ -n $wait_timer_pid ]]; then
        kill -TERM "$wait_timer_pid" 2>/dev/null || true
        wait "$wait_timer_pid" 2>/dev/null || true
        wait_timer_pid=
    fi
}

cleanup() {
    stop_wait_timer
    if ((started_here)); then
        started_here=0
        if [[ -n $started_invocation_id && -n $started_owner_token ]] && service_is_active &&
            [[ $(service_invocation_id) == "$started_invocation_id" ]] &&
            token_file_matches "$active_token_path" "$started_owner_token"; then
            "$systemctl_bin" --user stop "$service_name" || true
            if service_is_inactive && token_file_matches "$active_token_path" "$started_owner_token"; then
                rm -f -- "$active_token_path"
            fi
        fi
    fi
    if [[ -n $reservation_token ]] && service_is_inactive && [[ ! -e $active_token_path ]] &&
        token_file_matches "$pending_token_path" "$reservation_token"; then
        rm -f -- "$pending_token_path"
    fi
}

forward_signal() {
    local signal=$1 exit_status=$2
    if [[ -n $game_pid ]]; then
        kill -"$signal" "$game_pid" 2>/dev/null || true
        wait "$game_pid" 2>/dev/null || true
        game_pid=
    fi
    stop_wait_timer
    exit "$exit_status"
}

trap cleanup EXIT
trap 'forward_signal INT 130' INT
trap 'forward_signal TERM 143' TERM

if (($# == 0)); then
    printf 'error: game command is required\n' >&2
    exit 2
fi

if [[ -z $runtime_dir ]]; then
    printf 'error: XDG_RUNTIME_DIR is required\n' >&2
    exit 1
fi

umask 0077
lock_path="$runtime_dir/forza-linux.lock"
if [[ ${FORZA_LOCK_BOOTSTRAP_PID:-} != "$$" || ${FORZA_LOCK_FD:-} != 9 ]]; then
    exec python3 -c '
import fcntl
import os
import stat
import sys

launcher = os.path.abspath(sys.argv[1])
lock_path = sys.argv[2]
try:
    descriptor = os.open(
        lock_path,
        os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o600,
    )
except OSError as error:
    print(f"error: cannot open safe Forza launcher lock: {error}", file=sys.stderr)
    raise SystemExit(1)

info = os.fstat(descriptor)
if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
    os.close(descriptor)
    print("error: Forza launcher lock must be a current-user regular file", file=sys.stderr)
    raise SystemExit(1)
try:
    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    os.close(descriptor)
    print("error: another Forza launcher is already running", file=sys.stderr)
    raise SystemExit(1)
except OSError as error:
    os.close(descriptor)
    print(f"error: cannot lock Forza launcher coordinator: {error}", file=sys.stderr)
    raise SystemExit(1)

if descriptor != 9:
    os.dup2(descriptor, 9, inheritable=True)
    os.close(descriptor)
else:
    os.set_inheritable(descriptor, True)
environment = os.environ.copy()
environment["FORZA_LOCK_BOOTSTRAP_PID"] = str(os.getpid())
environment["FORZA_LOCK_FD"] = "9"
os.execve(launcher, [launcher, *sys.argv[3:]], environment)
' "$0" "$lock_path" "$@"
fi
coordinator_fd=$FORZA_LOCK_FD
unset FORZA_LOCK_BOOTSTRAP_PID FORZA_LOCK_FD

if [[ -n ${PAM_KWALLET5_LOGIN:-} && -S ${PAM_KWALLET5_LOGIN} ]]; then
    "$systemctl_bin" --user start plasma-kwallet-pam.service || true
fi

socket_path="$runtime_dir/xodus.sock"
pending_token_path="$runtime_dir/forza-xodus-owner.pending"
active_token_path="$runtime_dir/forza-xodus-owner.active"

if service_is_active; then
    :
else
    activity_status=$?
    if ((activity_status != 3)); then
        printf 'error: cannot determine whether %s is active\n' "$service_name" >&2
        exit 1
    fi
    if [[ -S $socket_path ]]; then
        rm -f -- "$socket_path"
    fi
    rm -f -- "$pending_token_path" "$active_token_path"
    reservation_token=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    if [[ -z $reservation_token ]]; then
        printf 'error: cannot reserve %s ownership\n' "$service_name" >&2
        exit 1
    fi
    pending_token_temp=$(mktemp "$runtime_dir/.forza-xodus-owner.pending.XXXXXX") || {
        printf 'error: cannot reserve %s ownership\n' "$service_name" >&2
        exit 1
    }
    chmod 600 -- "$pending_token_temp"
    printf '%s' "$reservation_token" >"$pending_token_temp"
    if ! mv -T -- "$pending_token_temp" "$pending_token_path"; then
        rm -f -- "$pending_token_temp"
        printf 'error: cannot reserve %s ownership\n' "$service_name" >&2
        exit 1
    fi
    if service_is_active; then
        printf 'error: %s became active during ownership reservation\n' "$service_name" >&2
        exit 1
    fi
    if ! "$systemctl_bin" --user start "$service_name"; then
        printf 'error: cannot start %s\n' "$service_name" >&2
        exit 1
    fi
    started_invocation_id=$(service_invocation_id)
    if [[ -z $started_invocation_id ]] || ! token_file_matches "$active_token_path" "$reservation_token"; then
        printf 'error: cannot capture %s invocation identity\n' "$service_name" >&2
        started_invocation_id=
        started_owner_token=
        exit 1
    fi
    started_owner_token=$reservation_token
    started_here=1
fi

monotonic_ms() {
    awk '{ printf "%.0f\n", $1 * 1000 }' /proc/uptime
}

wait_for_game() {
    local completed wait_status
    while :; do
        (
            exec {coordinator_fd}>&-
            sleep 0.05
        ) &
        wait_timer_pid=$!
        if wait -n -p completed "$game_pid" "$wait_timer_pid"; then
            wait_status=0
        else
            wait_status=$?
        fi
        if [[ $completed == "$game_pid" ]]; then
            stop_wait_timer
            game_status=$wait_status
            game_pid=
            return
        fi
        wait_timer_pid=
    done
}

deadline=$(($(monotonic_ms) + 4800))
until socket_is_listening && service_is_active; do
    now=$(monotonic_ms)
    if ((now >= deadline)); then
        printf 'error: timed out waiting for %s\n' "$socket_path" >&2
        exit 1
    fi
    remaining=$((deadline - now))
    sleep_seconds=$(awk -v milliseconds="$remaining" 'BEGIN {
        if (milliseconds > 50) print "0.05";
        else printf "%.3f\n", milliseconds / 1000;
    }')
    sleep "$sleep_seconds"
done

(
    exec {coordinator_fd}>&-
    exec env --default-signal=INT --default-signal=TERM "$@"
) &
game_pid=$!
wait_for_game
exit "$game_status"
