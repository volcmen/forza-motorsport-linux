#!/usr/bin/env bash

set -u

app_id=2440510
tool_name=GE-Proton11-3-FM
test_root=${FORZA_TEST_ROOT:-}

if [[ -n $test_root ]]; then
    home_root=$test_root
    data_root="$home_root/.local/share"
else
    home_root=${HOME:?HOME is required}
    data_root=${XDG_DATA_HOME:-"$home_root/.local/share"}
fi

steam_root="$data_root/Steam"
prefix_root="$steam_root/steamapps/compatdata/$app_id/pfx/drive_c"
runtime_root="$home_root/.local"
patcher="$runtime_root/libexec/forza-motorsport-linux/patch-known-build"
manifest="$runtime_root/share/forza-motorsport-linux/supported-builds.toml"
systemctl_bin=${FORZA_SYSTEMCTL:-systemctl}
busctl_bin=${FORZA_BUSCTL:-busctl}
df_bin=${FORZA_DF:-df}
failed=0

report() {
    local state=$1 check=$2 detail=$3
    printf '%s %s: %s\n' "$state" "$check" "$detail"
    [[ $state != FAIL ]] || failed=1
}

report_file() {
    local check=$1 path=$2
    if [[ -f $path ]]; then
        report PASS "$check" present
    else
        report FAIL "$check" missing
    fi
}

report_executable() {
    local check=$1 path=$2
    if [[ -f $path && ! -L $path && -x $path ]]; then
        report PASS "$check" present
    else
        report FAIL "$check" missing-or-not-executable
    fi
}

report_directory() {
    local check=$1 path=$2
    if [[ -d $path ]]; then
        report PASS "$check" present
    else
        report FAIL "$check" missing
    fi
}

has_kde_secret_service_provider() {
    local candidate= check_executable data_dir executable line name= exec=
    local active_section=0 invalid_key=0 name_count=0 exec_count=0 section_count=0
    local -a data_dirs=("$data_root")
    if [[ -n $test_root ]]; then
        data_dirs+=("$test_root/usr/local/share" "$test_root/usr/share")
    else
        local -a xdg_data_dirs
        IFS=: read -r -a xdg_data_dirs <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
        for data_dir in "${xdg_data_dirs[@]}"; do
            [[ $data_dir == /* ]] && data_dirs+=("$data_dir")
        done
    fi
    for data_dir in "${data_dirs[@]}"; do
        if [[ -e $data_dir/dbus-1/services/org.freedesktop.secrets.service || \
            -L $data_dir/dbus-1/services/org.freedesktop.secrets.service ]]; then
            candidate="$data_dir/dbus-1/services/org.freedesktop.secrets.service"
            break
        fi
    done
    [[ -n $candidate && -f $candidate && ! -L $candidate ]] || return 1

    while IFS= read -r line || [[ -n $line ]]; do
        case "$line" in
            '[D-BUS Service]')
                active_section=1
                ((section_count += 1))
                ;;
            \[*\]) active_section=0 ;;
            Name=*)
                if ((active_section)); then
                    name=${line#Name=}
                    ((name_count += 1))
                else
                    invalid_key=1
                fi
                ;;
            Exec=*)
                if ((active_section)); then
                    exec=${line#Exec=}
                    ((exec_count += 1))
                else
                    invalid_key=1
                fi
                ;;
        esac
    done < "$candidate"
    ((section_count == 1 && name_count == 1 && exec_count == 1 && !invalid_key)) || return 1
    [[ $name == org.freedesktop.secrets ]] || return 1
    if ! executable=$(python3 - "$exec" <<'PY'
import shlex
import sys

try:
    command = shlex.split(sys.argv[1])
except ValueError:
    raise SystemExit(1)
if not command:
    raise SystemExit(1)
print(command[0])
PY
    ); then
        return 1
    fi
    case "$executable" in
        /usr/bin/ksecretd | /usr/bin/ksecretd5 | /usr/bin/ksecretd6 | /usr/bin/kwalletd | /usr/bin/kwalletd5 | /usr/bin/kwalletd6) ;;
        *) return 1 ;;
    esac
    check_executable=$executable
    [[ -z $test_root ]] || check_executable="$test_root$executable"
    [[ -f $check_executable && ! -L $check_executable && -x $check_executable ]]
}

inspect_target() {
    local target=$1 state
    if [[ ! -x $patcher || ! -f $manifest ]]; then
        printf 'unknown\n'
        return
    fi
    if state=$("$patcher" inspect --manifest "$manifest" --target "$target" 2>/dev/null); then
        case "$state" in
            original | patched) printf '%s\n' "$state" ;;
            *) printf 'unknown\n' ;;
        esac
    else
        printf 'unknown\n'
    fi
}

report_known_builds() {
    local target state has_original=0 has_unknown=0
    local -a targets=(
        "$steam_root/compatibilitytools.d/$tool_name/files/lib/wine/x86_64-windows/windows.gaming.input.dll"
        "$prefix_root/windows/system32/windows.gaming.input.dll"
        "$steam_root/compatibilitytools.d/$tool_name/files/lib/wine/x86_64-windows/mountmgr.sys"
        "$prefix_root/windows/system32/drivers/mountmgr.sys"
    )
    for target in "${targets[@]}"; do
        state=$(inspect_target "$target")
        case "$state" in
            patched) ;;
            original) has_original=1 ;;
            *) has_unknown=1 ;;
        esac
    done
    if ((has_unknown)); then
        report FAIL 'controller and mountmgr known-build states' 'unrecognized or unavailable'
    elif ((has_original)); then
        report WARN 'controller and mountmgr known-build states' 'reviewed original build needs patching'
    else
        report PASS 'controller and mountmgr known-build states' 'reviewed patched build'
    fi
}

report_disk_space() {
    local available_kb
    available_kb=$("$df_bin" -Pk "$steam_root" 2>/dev/null | awk 'NR == 2 { print $4 }')
    if [[ ! $available_kb =~ ^[0-9]+$ ]]; then
        report FAIL 'current free disk space' unavailable
    elif ((available_kb >= 104857600)); then
        report PASS 'current free disk space' 'at least 100 GiB available'
    elif ((available_kb >= 31457280)); then
        report WARN 'current free disk space' 'below 100 GiB available'
    else
        report FAIL 'current free disk space' 'below 30 GiB available'
    fi
}

report_file 'Steam AppID manifest' "$steam_root/steamapps/appmanifest_$app_id.acf"
report_directory "$tool_name directory" "$steam_root/compatibilitytools.d/$tool_name"
report_executable 'Xodus service binary' "$runtime_root/libexec/xodus-forza/xodus-service"
report_file 'user-supplied xgameruntime.dll.threading' "$prefix_root/windows/system32/xgameruntime.dll.threading"

if "$busctl_bin" --user --quiet status org.freedesktop.secrets >/dev/null 2>&1; then
    report PASS 'Secret Service' 'D-Bus owner is available'
elif has_kde_secret_service_provider; then
    report PASS 'Secret Service' 'activatable KDE provider is available'
else
    report FAIL 'Secret Service' 'no owner or activatable KDE provider'
fi

service_state=$("$systemctl_bin" --user show --property=UnitFileState --value xodus-forza.service 2>/dev/null || true)
case "$service_state" in
    disabled) report PASS 'xodus-forza.service disabled state' disabled ;;
    enabled) report FAIL 'xodus-forza.service disabled state' enabled ;;
    *) report WARN 'xodus-forza.service disabled state' unavailable ;;
esac

report_known_builds
report_disk_space

exit "$failed"
