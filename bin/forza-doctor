#!/usr/bin/env bash

set -u

app_id=2440510
tool_name=GE-Proton11-3-FM
test_root=${FORZA_TEST_ROOT:-}

if [[ -n $test_root ]]; then
    home_root=$test_root
    data_root="$home_root/.local/share"
else
    home_root=${HOME:?HOME is required}
    data_root=${XDG_DATA_HOME:-"$home_root/.local/share"}
fi

steam_root="$data_root/Steam"
library_root=$steam_root
disk_root="$library_root/steamapps"
prefix_root="$steam_root/steamapps/compatdata/$app_id/pfx/drive_c"
runtime_root="$home_root/.local"
patcher="$runtime_root/libexec/forza-motorsport-linux/patch-known-build"
manifest="$runtime_root/share/forza-motorsport-linux/supported-builds.toml"
systemctl_bin=${FORZA_SYSTEMCTL:-systemctl}
busctl_bin=${FORZA_BUSCTL:-busctl}
df_bin=${FORZA_DF:-df}
failed=0
composed_wgi=''
composed_mountmgr=''

report() {
    local state=$1 check=$2 detail=$3
    printf '%s %s: %s\n' "$state" "$check" "$detail"
    [[ $state != FAIL ]] || failed=1
}

report_file() {
    local check=$1 path=$2
    if [[ -f $path ]]; then
        report PASS "$check" present
    else
        report FAIL "$check" missing
    fi
}

report_executable() {
    local check=$1 path=$2
    if [[ -f $path && ! -L $path && -x $path ]]; then
        report PASS "$check" present
    else
        report FAIL "$check" missing-or-not-executable
    fi
}

report_directory() {
    local check=$1 path=$2
    if [[ -d $path ]]; then
        report PASS "$check" present
    else
        report FAIL "$check" missing
    fi
}

has_kde_secret_service_provider() {
    local service_name=${1:-org.freedesktop.secrets}
    local candidate='' check_executable data_dir executable line name='' exec=''
    local active_section=0 invalid_key=0 name_count=0 exec_count=0 section_count=0
    local -a data_dirs=("$data_root")
    if [[ -n $test_root ]]; then
        data_dirs+=("$test_root/usr/local/share" "$test_root/usr/share")
    else
        local -a xdg_data_dirs
        IFS=: read -r -a xdg_data_dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
        for data_dir in "${xdg_data_dirs[@]}"; do
            [[ $data_dir == /* ]] && data_dirs+=("$data_dir")
        done
    fi
    for data_dir in "${data_dirs[@]}"; do
        if [[ -e $data_dir/dbus-1/services/$service_name.service ||
            -L $data_dir/dbus-1/services/$service_name.service ]]; then
            candidate="$data_dir/dbus-1/services/$service_name.service"
            break
        fi
    done
    [[ -n $candidate && -f $candidate && ! -L $candidate ]] || return 1

    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        case "$line" in
            '[D-BUS Service]')
                active_section=1
                ((section_count += 1))
                ;;
            \[*\]) active_section=0 ;;
            Name=*)
                if ((active_section)); then
                    name=${line#Name=}
                    ((name_count += 1))
                else
                    invalid_key=1
                fi
                ;;
            Exec=*)
                if ((active_section)); then
                    exec=${line#Exec=}
                    ((exec_count += 1))
                else
                    invalid_key=1
                fi
                ;;
        esac
    done <"$candidate"
    ((section_count == 1 && name_count == 1 && exec_count == 1 && ! invalid_key)) || return 1
    [[ $name == "$service_name" ]] || return 1
    if ! executable=$(
        python3 - "$exec" <<'PY'
import shlex
import sys

try:
    command = shlex.split(sys.argv[1])
except ValueError:
    raise SystemExit(1)
if not command:
    raise SystemExit(1)
print(command[0])
PY
    ); then
        return 1
    fi
    case "$executable" in
        /usr/bin/ksecretd | /usr/bin/ksecretd5 | /usr/bin/ksecretd6 | /usr/bin/kwalletd | /usr/bin/kwalletd5 | /usr/bin/kwalletd6) ;;
        *) return 1 ;;
    esac
    check_executable=$executable
    [[ -z $test_root ]] || check_executable="$test_root$executable"
    [[ -f $check_executable && ! -L $check_executable && -x $check_executable ]]
}

inspect_target() {
    local target=$1 state expected=''
    case "${target##*/}" in
        windows.gaming.input.dll) expected=$composed_wgi ;;
        mountmgr.sys) expected=$composed_mountmgr ;;
    esac
    if [[ -n $expected ]]; then
        if [[ -f $target && ! -L $target ]] && state=$(sha256sum -- "$target") && [[ ${state%% *} == "$expected" ]]; then
            printf 'patched\n'
        else
            printf 'unknown\n'
        fi
        return
    fi
    if [[ ! -x $patcher || ! -f $manifest ]]; then
        printf 'unknown\n'
        return
    fi
    if state=$("$patcher" inspect --manifest "$manifest" --target "$target" 2>/dev/null); then
        case "$state" in
            original | patched) printf '%s\n' "$state" ;;
            *) printf 'unknown\n' ;;
        esac
    else
        printf 'unknown\n'
    fi
}

report_known_builds() {
    local target state original_count=0 patched_count=0 has_unknown=0
    local -a targets=(
        "$steam_root/compatibilitytools.d/$tool_name/files/lib/wine/x86_64-windows/windows.gaming.input.dll"
        "$prefix_root/windows/system32/windows.gaming.input.dll"
        "$steam_root/compatibilitytools.d/$tool_name/files/lib/wine/x86_64-windows/mountmgr.sys"
        "$prefix_root/windows/system32/drivers/mountmgr.sys"
    )
    for target in "${targets[@]}"; do
        state=$(inspect_target "$target")
        case "$state" in
            patched) ((patched_count += 1)) ;;
            original) ((original_count += 1)) ;;
            *) has_unknown=1 ;;
        esac
    done
    if ((has_unknown)); then
        report FAIL 'controller and mountmgr known-build states' 'unrecognized or unavailable'
    elif ((original_count == ${#targets[@]})); then
        report WARN 'controller and mountmgr known-build states' 'reviewed original build needs patching'
    elif ((patched_count == ${#targets[@]})); then
        report PASS 'controller and mountmgr known-build states' 'reviewed patched build'
    else
        report FAIL 'controller and mountmgr known-build states' 'mixed original and patched targets'
    fi
}

report_disk_space() {
    local available_kb
    if [[ -z $disk_root ]] || ! available_kb=$(
        set -o pipefail
        "$df_bin" -Pk -- "$disk_root" 2>/dev/null | awk 'NR == 2 { print $4 }'
    ) || [[ ! $available_kb =~ ^[0-9]+$ ]]; then
        report FAIL 'current free disk space' unavailable
    elif ((available_kb >= 104857600)); then
        report PASS 'current free disk space' 'at least 100 GiB available'
    elif ((available_kb >= 31457280)); then
        report WARN 'current free disk space' 'below 100 GiB available'
    else
        report FAIL 'current free disk space' 'below 30 GiB available'
    fi
}

# A composed installation records the actual Steam library and prefix. Read only
# private, checksum-bound plans; these hashes never authorize binary patching.
if [[ -e $home_root/.local/state/forza-motorsport-linux/bootstrap-v2/active.json ||
    -L $home_root/.local/state/forza-motorsport-linux/bootstrap-v2/active.json ]]; then
    if composed_paths=$(
        python3 - "$home_root" "$manifest" <<'PY'
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys
import tomllib

def unique(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError("duplicate record key")
        value[key] = item
    return value

def read(path, private=True):
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in path.parts[1:-1]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = child
        file = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
        try:
            info = os.fstat(file)
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_size > 262144
                or (private and stat.S_IMODE(info.st_mode) != 0o600)):
                raise ValueError("unsafe record metadata")
            return os.read(file, 262145)
        finally:
            os.close(file)
    finally:
        os.close(fd)

def record(path):
    return json.loads(read(path), object_pairs_hook=unique)

def digest(value):
    data = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode()
    return hashlib.sha256(data).hexdigest()

def binding(value):
    path = Path(value["path"])
    if not path.is_absolute() or ".." in path.parts or any(ord(c) < 32 for c in str(path)):
        raise ValueError("invalid recorded path")
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in path.parts[1:]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = child
        info = os.fstat(fd)
        if info.st_uid != os.getuid() or (info.st_dev, info.st_ino) != (value["device"], value["inode"]):
            raise ValueError("recorded directory changed")
    finally:
        os.close(fd)
    return path

try:
    home = Path(sys.argv[1])
    base = home / ".local/state/forza-motorsport-linux/bootstrap-v2"
    active = record(base / "active.json")
    if set(active) != {"schema", "transaction_id"} or type(active["schema"]) is not int or active["schema"] != 2:
        raise ValueError("invalid active record")
    token = active["transaction_id"]
    if not isinstance(token, str) or re.fullmatch(r"[a-f0-9]{24}", token) is None:
        raise ValueError("invalid transaction identity")
    transaction = base / token
    state = record(transaction / "state.json")
    if state["schema"] != 2 or state["transaction_id"] != token:
        raise ValueError("invalid parent identity")
    if state["phase"] == "ROLLED_BACK":
        raise SystemExit(0)
    if state["phase"] not in {"INSTALLING_FINISH", "READY_TO_ATTEMPT"}:
        raise ValueError("composed Finish is incomplete")
    known = tomllib.loads(read(Path(sys.argv[2]), private=False).decode())["composed"]
    if state["manifest_sha256"] != known["manifest_sha256"]:
        raise ValueError("unrecognized composed release")
    prepare = record(transaction / "prepare-plan.json")
    finish = record(transaction / "finish-plan.json")
    if (digest(prepare) != state["prepare_plan_sha256"] or digest(finish) != state["finish_plan_sha256"]
        or prepare["manifest_sha256"] != state["manifest_sha256"]
        or finish["manifest_sha256"] != state["manifest_sha256"] or finish["transaction_id"] != token):
        raise ValueError("recorded plan changed")
    roots = prepare["bindings"]
    if binding(roots["home"]) != home:
        raise ValueError("recorded home changed")
    steam, library = binding(roots["steam"]), binding(roots["library"])
    game = binding(roots["game"])
    prefix = binding(finish["prefix"])
    if binding(finish["system32"]) != prefix / "drive_c/windows/system32":
        raise ValueError("recorded prefix changed")
    for key in ("windows_gaming_input_sha256", "mountmgr_sha256"):
        if re.fullmatch(r"[a-f0-9]{64}", known[key]) is None:
            raise ValueError("invalid read-only module hash")
    for value in (steam, library, prefix / "drive_c", known["windows_gaming_input_sha256"], known["mountmgr_sha256"], game):
        print(value)
except (OSError, ValueError, KeyError, TypeError) as error:
    print(f"composed records: {error}", file=sys.stderr)
    raise SystemExit(1)
PY
    ); then
        if [[ -n $composed_paths ]]; then
            mapfile -t composed_values <<<"$composed_paths"
            steam_root=${composed_values[0]}
            library_root=${composed_values[1]}
            prefix_root=${composed_values[2]}
            composed_wgi=${composed_values[3]}
            composed_mountmgr=${composed_values[4]}
            disk_root=${composed_values[5]}
            report PASS 'composed installation records' 'reviewed plans and directory identities'
        fi
    else
        disk_root=''
        report FAIL 'composed installation records' 'incomplete, changed, or unsafe'
    fi
fi

report_file 'Steam AppID manifest' "$library_root/steamapps/appmanifest_$app_id.acf"
report_directory "$tool_name directory" "$steam_root/compatibilitytools.d/$tool_name"
report_executable 'Xodus service binary' "$runtime_root/libexec/xodus-forza/xodus-service"
report_file 'user-supplied xgameruntime.dll.threading' "$prefix_root/windows/system32/xgameruntime.dll.threading"

if "$busctl_bin" --user --quiet status org.freedesktop.secrets >/dev/null 2>&1; then
    report PASS 'Secret Service' 'D-Bus owner is available'
elif has_kde_secret_service_provider || has_kde_secret_service_provider org.kde.secretservicecompat; then
    report PASS 'Secret Service' 'activatable KDE provider is available'
else
    report FAIL 'Secret Service' 'no owner or activatable KDE provider'
fi

if service_state=$("$systemctl_bin" --user show --property=UnitFileState --value xodus-forza.service 2>/dev/null); then
    case "$service_state" in
        disabled | static) report PASS 'xodus-forza.service disabled state' "$service_state" ;;
        missing) report FAIL 'xodus-forza.service disabled state' missing ;;
        masked) report FAIL 'xodus-forza.service disabled state' masked ;;
        enabled*) report FAIL 'xodus-forza.service disabled state' "$service_state" ;;
        *) report FAIL 'xodus-forza.service disabled state' "unknown state: ${service_state:-empty}" ;;
    esac
else
    report FAIL 'xodus-forza.service disabled state' query-error
fi

report_known_builds
report_disk_space

exit "$failed"
