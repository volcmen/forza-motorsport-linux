[Unit]
Description=Xodus service for one Forza Motorsport session

[Service]
Type=simple
ExecStart=%h/.local/libexec/xodus-forza/xodus-service
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# PrivateUsers is intentionally off until Unix peer-credential compatibility is proven;
# without it in a user manager, ProtectSystem/ReadWritePaths may not enforce socket-only writes.
ReadWritePaths=%t/xodus.sock
