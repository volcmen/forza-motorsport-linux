[Unit]
Description=Xodus service for one Forza Motorsport session

[Service]
Type=simple
ExecStartPre=/usr/bin/bash -c 'set -eu; test -f "%t/forza-xodus-owner.pending"; test ! -e "%t/forza-xodus-owner.active"; mv -T -- "%t/forza-xodus-owner.pending" "%t/forza-xodus-owner.active"'
ExecStart=%h/.local/libexec/xodus-forza/xodus-service
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# PrivateUsers is intentionally off until Unix peer-credential compatibility is proven;
# without it in a user manager, filesystem namespacing is not a security boundary.
# The service must create xodus.sock and atomically rename the launcher token after
# namespace setup, so its existing per-user runtime directory must remain writable.
ReadWritePaths=%t
