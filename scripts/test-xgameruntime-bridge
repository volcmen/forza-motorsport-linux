#!/usr/bin/env bash

set -euo pipefail

usage() {
    printf 'usage: %s WINEGDK_BUILD GE_PROTON_FILES WINEPREFIX FIXTURE\n' "$0" >&2
    exit 64
}

[[ $# -eq 4 ]] || usage

build_dir=$1
ge_files=$2
wine_prefix=$3
fixture=$4
transport_test=$(dirname "$fixture")/xgameruntime-transport-test.py
runtime_fixture=$(dirname "$fixture")/xodus-runtime-fixture.py

for path in "$build_dir" "$ge_files" "$wine_prefix"; do
    [[ $path = /* && -d $path ]] || usage
done
[[ $fixture = /* && -f $fixture ]] || usage
[[ -f $transport_test ]] || usage
[[ -f $runtime_fixture ]] || usage

runtime_dir=$(mktemp -d /tmp/forza-xgameruntime-test.XXXXXX)
overlay_dir=$(mktemp -d "$build_dir/.ge-overlay.XXXXXX")
fixture_pid=

remove_test_tree() {
    local path=$1
    local expected_prefix=$2

    case "$path" in
        "$expected_prefix"*) rm -rf --one-file-system -- "$path" ;;
        *)
            printf 'refusing unsafe cleanup path: %s\n' "$path" >&2
            return 1
            ;;
    esac
}

cleanup() {
    local status=$?

    if [[ -n $fixture_pid ]] && kill -0 "$fixture_pid" 2>/dev/null; then
        kill "$fixture_pid" 2>/dev/null || true
        wait "$fixture_pid" 2>/dev/null || true
    fi
    remove_test_tree "$overlay_dir" "$build_dir/.ge-overlay."
    remove_test_tree "$runtime_dir" /tmp/forza-xgameruntime-test.
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

make --no-print-directory -s -C "$build_dir/dlls/xgameruntime" -j2
make --no-print-directory -s -C "$build_dir/dlls/xgameruntime/tests" -j2

printf 'gate 0/19: native private-socket and social transport contracts\n'
env \
    LD_LIBRARY_PATH="$build_dir/dlls/ntdll${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
    uv run "$transport_test" "$build_dir/dlls/xgameruntime/xgameruntime.so"

cp -al "$ge_files/." "$overlay_dir/"
unlink "$overlay_dir/lib/wine/x86_64-windows/xgameruntime.dll"
unlink "$overlay_dir/lib/wine/x86_64-unix/xgameruntime.so"
install -m 0644 \
    "$build_dir/dlls/xgameruntime/x86_64-windows/xgameruntime.dll" \
    "$overlay_dir/lib/wine/x86_64-windows/xgameruntime.dll"
install -m 0755 \
    "$build_dir/dlls/xgameruntime/xgameruntime.so" \
    "$overlay_dir/lib/wine/x86_64-unix/xgameruntime.so"

cmp -s \
    "$build_dir/dlls/xgameruntime/x86_64-windows/xgameruntime.dll" \
    "$overlay_dir/lib/wine/x86_64-windows/xgameruntime.dll"
cmp -s \
    "$build_dir/dlls/xgameruntime/xgameruntime.so" \
    "$overlay_dir/lib/wine/x86_64-unix/xgameruntime.so"

run_test() {
    local mode=$1
    local ready_marker=${2:-}
    local -a mode_env=()

    if [[ -n $mode ]]; then
        mode_env=(XGAMERUNTIME_TEST_XODUS="$mode")
    fi
    if [[ -n $ready_marker ]]; then
        mode_env+=(XGAMERUNTIME_TEST_SOCIAL_READY="$ready_marker")
    fi

    env \
        WINEPREFIX="$wine_prefix" \
        WINEDEBUG=-all \
        WINEDLLOVERRIDES=xgameruntime=b \
        XDG_RUNTIME_DIR="$runtime_dir" \
        WINETEST_PLATFORM=wine \
        WINETEST_DEBUG=1 \
        WINETEST_REPORT_SUCCESS=0 \
        "${mode_env[@]}" \
        timeout --foreground 25s \
        "$overlay_dir/bin/wine" \
        "$build_dir/dlls/xgameruntime/tests/x86_64-windows/xgameruntime_test.exe" \
        xgameruntime
}

printf 'gate 1/19: baseline with social fixture disabled\n'
run_test ""

printf 'gate 2/19: bounded refusal and repeatable teardown\n'
run_test failure

printf 'gate 3/19: two synthetic main-stream lifecycles\n'
uv run "$runtime_fixture" "$runtime_dir/xodus.sock" --scenario success \
    >"$runtime_dir/fixture.log" 2>&1 &
fixture_pid=$!
for _ in {1..100}; do
    if rg -q '^READY$' "$runtime_dir/fixture.log"; then
        break
    fi
    kill -0 "$fixture_pid" 2>/dev/null || {
        cat "$runtime_dir/fixture.log" >&2
        exit 1
    }
    sleep 0.05
done
rg -q '^READY$' "$runtime_dir/fixture.log"
run_test success
wait "$fixture_pid"
fixture_pid=

run_social_scenario() {
    local gate=$1
    local scenario=$2
    local ready_marker=
    local log_path="$runtime_dir/social-$scenario.log"
    local -a fixture_args=("$runtime_dir/xodus.sock" --scenario "$scenario")
    local test_mode="social-$scenario"

    if [[ $scenario == wait-cancel || $scenario == invite-multiple ]]; then
        ready_marker="$runtime_dir/social-ready"
        fixture_args+=(--ready-marker "$ready_marker")
    fi
    if [[ $scenario == invite-* ]]; then
        test_mode="$scenario"
    fi

    printf 'gate %s/19: hermetic %s\n' "$gate" "$scenario"
    uv run "$runtime_fixture" "${fixture_args[@]}" >"$log_path" 2>&1 &
    fixture_pid=$!
    for _ in {1..100}; do
        if rg -q '^READY$' "$log_path"; then
            break
        fi
        kill -0 "$fixture_pid" 2>/dev/null || {
            cat "$log_path" >&2
            exit 1
        }
        sleep 0.05
    done
    rg -q '^READY$' "$log_path"
    run_test "$test_mode" "$ready_marker"
    if ! wait "$fixture_pid"; then
        cat "$log_path" >&2
        fixture_pid=
        return 1
    fi
    fixture_pid=
}

run_social_scenario 4 success
run_social_scenario 5 user-cancel
run_social_scenario 6 immediate-fail
run_social_scenario 7 wait-cancel
run_social_scenario 8 unavailable
run_social_scenario 9 preack-timeout
run_social_scenario 10 invite-delivery
run_social_scenario 11 invite-self-unregister
run_social_scenario 12 invite-unregister
run_social_scenario 13 invite-reconnect
run_social_scenario 14 invite-multiple
run_social_scenario 15 invite-default-queue
run_social_scenario 16 invite-wait-pending
run_social_scenario 17 invite-concurrent-waiters
run_social_scenario 18 invite-main-failure
run_social_scenario 19 invite-subscriber-unavailable

printf 'all XGameRuntime bridge gates passed\n'
