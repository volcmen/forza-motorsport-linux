#!/usr/bin/env bash

set -u

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
HELPER="$ROOT/scripts/secure-user-files"
install_root=${FORZA_INSTALL_ROOT:-}
xodus_build=
explicit_root=0
check_only=0

usage() {
    printf '%s\n' "usage: $0 [--check] [--root PATH] --xodus-build-dir PATH" >&2
    exit 64
}

while (($#)); do
    case "$1" in
        --root)
            (($# >= 2)) || usage
            install_root=$2
            explicit_root=1
            shift 2
            ;;
        --xodus-build-dir)
            (($# >= 2)) || usage
            xodus_build=$2
            shift 2
            ;;
        --check)
            check_only=1
            shift
            ;;
        --help) usage ;;
        *) usage ;;
    esac
done

[[ -n $install_root ]] || install_root=${HOME:?HOME is required}
[[ -n $xodus_build ]] || usage
[[ $install_root == /* && $xodus_build == /* ]] || {
    printf '%s\n' 'error: root and Xodus build directory must be absolute paths' >&2
    exit 1
}

source_arguments=(
    --source ".local/bin/forza-linux=$ROOT/bin/forza-linux"
    --source ".local/bin/forza-doctor=$ROOT/bin/forza-doctor"
    --source ".local/libexec/forza-motorsport-linux/patch-known-build=$ROOT/scripts/patch-known-build"
    --source ".local/share/forza-motorsport-linux/supported-builds.toml=$ROOT/manifests/supported-builds.toml"
    --source ".local/libexec/xodus-forza/xodus-service=$xodus_build/xodus-service"
    --source ".local/libexec/xodus-forza/xodus-cli=$xodus_build/xodus-cli"
    --source ".local/libexec/xodus-forza/xodus-overlay=$xodus_build/xodus-overlay"
    --source ".config/systemd/user/xodus-forza.service=$ROOT/config/xodus-forza.service"
)

if ! command -v systemctl >/dev/null 2>&1; then
    printf '%s\n' 'FAIL dependency: systemctl is unavailable' >&2
    printf '%s\n' 'ACTION: install systemd user tools before installing' >&2
    exit 1
fi
printf '%s\n' 'PASS dependency: systemctl is available'
"$HELPER" check --root "$install_root" "${source_arguments[@]}" || exit $?
printf '%s\n' 'PLAN reload: systemctl --user daemon-reload'
((check_only)) && exit 0

arguments=(install --root "$install_root")
((explicit_root)) && arguments+=(--explicit-root)
arguments+=("${source_arguments[@]}")
"$HELPER" "${arguments[@]}" || exit $?
systemctl --user daemon-reload || {
    printf '%s\n' 'error: cannot reload user systemd daemon' >&2
    exit 1
}
printf '%s\n' 'installed Forza Motorsport Linux user integration'
