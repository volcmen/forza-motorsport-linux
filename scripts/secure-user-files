#!/usr/bin/env python3
"""No-follow user-local file transaction primitives for the installer."""

from __future__ import annotations

import argparse
import ctypes
import errno
import hashlib
import os
import secrets
import stat
import sys
import time
from collections.abc import Iterable


PAYLOADS = (
    ".local/bin/forza-linux",
    ".local/bin/forza-doctor",
    ".local/libexec/forza-motorsport-linux/patch-known-build",
    ".local/share/forza-motorsport-linux/supported-builds.toml",
    ".local/libexec/xodus-forza/xodus-service",
    ".local/libexec/xodus-forza/xodus-cli",
    ".local/libexec/xodus-forza/xodus-overlay",
    ".config/systemd/user/xodus-forza.service",
)
MANIFEST = ".local/state/forza-motorsport-linux/install-manifest"
STATE_ROOT = ".local/state/forza-motorsport-linux"
RECOVERY_ROOT = f"{STATE_ROOT}/recovery"
JOURNAL = f"{STATE_ROOT}/transaction-journal"
HEADER = "forza-motorsport-linux-install-v1"
DIRECTORY = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
RENAME_NOREPLACE = 1
LIBC = ctypes.CDLL(None, use_errno=True)
RENAMEAT2 = getattr(LIBC, "renameat2", None)
if RENAMEAT2 is not None:
    RENAMEAT2.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
    RENAMEAT2.restype = ctypes.c_int


class SecureFilesError(RuntimeError):
    """A filesystem path failed the fail-closed user-install policy."""


def digest(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def relative_parts(relative: str) -> list[str]:
    parts = relative.split("/")
    if not relative or relative.startswith("/") or any(part in {"", ".", ".."} for part in parts):
        raise SecureFilesError(f"unsafe relative path: {relative}")
    return parts


def open_absolute_directory(path: str) -> int:
    if not os.path.isabs(path):
        raise SecureFilesError(f"path must be absolute: {path}")
    fd = os.open("/", DIRECTORY)
    try:
        for part in relative_parts(path[1:]) if path != "/" else []:
            next_fd = os.open(part, DIRECTORY, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        return fd
    except Exception:
        os.close(fd)
        raise


def open_parent(root_fd: int, relative: str, *, create: bool) -> tuple[int, str]:
    parts = relative_parts(relative)
    fd = os.dup(root_fd)
    try:
        for part in parts[:-1]:
            try:
                next_fd = os.open(part, DIRECTORY, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    raise
                os.mkdir(part, 0o755, dir_fd=fd)
                next_fd = os.open(part, DIRECTORY, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        return fd, parts[-1]
    except Exception:
        os.close(fd)
        raise


def read_regular_at(parent_fd: int, leaf: str, *, executable: bool = False) -> tuple[bytes, int, os.stat_result]:
    fd = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=parent_fd)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise SecureFilesError(f"not a regular file: {leaf}")
        mode = stat.S_IMODE(info.st_mode)
        if executable and not mode & 0o111:
            raise SecureFilesError(f"not executable: {leaf}")
        chunks: list[bytes] = []
        while block := os.read(fd, 1024 * 1024):
            chunks.append(block)
        return b"".join(chunks), mode, info
    finally:
        os.close(fd)


def read_regular_absolute(path: str, *, executable: bool) -> tuple[bytes, int]:
    parent, leaf = os.path.split(path)
    parent_fd = open_absolute_directory(parent)
    try:
        data, mode, _ = read_regular_at(parent_fd, leaf, executable=executable)
        return data, mode
    finally:
        os.close(parent_fd)


def write_new_at(parent_fd: int, leaf: str, data: bytes, mode: int) -> None:
    fd = os.open(leaf, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode, dir_fd=parent_fd)
    try:
        view = memoryview(data)
        while view:
            written = os.write(fd, view)
            view = view[written:]
        os.fchmod(fd, mode)
    finally:
        os.close(fd)


def rename_noreplace(source_fd: int, source: str, destination_fd: int, destination: str) -> None:
    if RENAMEAT2 is None:
        raise SecureFilesError("renameat2 RENAME_NOREPLACE is unavailable")
    result = RENAMEAT2(source_fd, os.fsencode(source), destination_fd, os.fsencode(destination), RENAME_NOREPLACE)
    if result == 0:
        return
    error_number = ctypes.get_errno()
    if error_number in {errno.ENOSYS, errno.EINVAL}:
        raise SecureFilesError("renameat2 RENAME_NOREPLACE is unavailable")
    raise OSError(error_number, os.strerror(error_number), destination)


def read_root_file(root_fd: int, relative: str) -> tuple[bytes, int, os.stat_result]:
    parent_fd, leaf = open_parent(root_fd, relative, create=False)
    try:
        return read_regular_at(parent_fd, leaf)
    finally:
        os.close(parent_fd)


def open_directory_relative(root_fd: int, relative: str, *, create: bool) -> int:
    fd = os.dup(root_fd)
    try:
        for part in relative_parts(relative):
            try:
                next_fd = os.open(part, DIRECTORY, dir_fd=fd)
            except FileNotFoundError:
                if not create:
                    raise
                os.mkdir(part, 0o700, dir_fd=fd)
                next_fd = os.open(part, DIRECTORY, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        return fd
    except Exception:
        os.close(fd)
        raise


def recovery_directory(root_fd: int, transaction: str) -> int:
    return open_directory_relative(root_fd, f"{RECOVERY_ROOT}/{transaction}", create=True)


def retire_name(parent_fd: int, leaf: str, root_fd: int, transaction: str, label: str) -> None:
    recovery_fd = recovery_directory(root_fd, transaction)
    try:
        for _ in range(100):
            name = f"{label}-{secrets.token_hex(12)}"
            try:
                rename_noreplace(parent_fd, leaf, recovery_fd, name)
                return
            except OSError as error:
                if error.errno != errno.EEXIST:
                    raise
        raise SecureFilesError("cannot reserve unique recovery name")
    finally:
        os.close(recovery_fd)


def parse_manifest(data: bytes) -> dict[str, tuple[int, str]]:
    try:
        lines = data.decode("utf-8").splitlines()
    except UnicodeDecodeError as error:
        raise SecureFilesError("install manifest is not UTF-8") from error
    if not lines or lines[0] != HEADER:
        raise SecureFilesError("unrecognized install manifest")
    records: dict[str, tuple[int, str]] = {}
    for line in lines[1:]:
        fields = line.split("\t")
        if len(fields) != 3:
            raise SecureFilesError("malformed install manifest entry")
        relative, mode_text, file_hash = fields
        if relative not in PAYLOADS or relative in records:
            raise SecureFilesError(f"install manifest path is not allowed: {relative}")
        if not mode_text.isdigit() or any(char not in "01234567" for char in mode_text):
            raise SecureFilesError(f"invalid install manifest mode: {relative}")
        if len(file_hash) != 64 or any(char not in "0123456789abcdef" for char in file_hash):
            raise SecureFilesError(f"invalid install manifest digest: {relative}")
        records[relative] = (int(mode_text, 8), file_hash)
    if set(records) != set(PAYLOADS):
        raise SecureFilesError("install manifest does not list every installed file")
    return records


def current_matches(root_fd: int, records: dict[str, tuple[int, str]]) -> bool:
    try:
        for relative, (mode, file_hash) in records.items():
            data, actual_mode, _ = read_root_file(root_fd, relative)
            if actual_mode != mode or digest(data) != file_hash:
                return False
    except (FileNotFoundError, OSError, SecureFilesError):
        return False
    return True


def manifest_bytes(records: dict[str, tuple[int, str]]) -> bytes:
    lines = [HEADER]
    for relative in PAYLOADS:
        mode, file_hash = records[relative]
        lines.append(f"{relative}\t{mode:o}\t{file_hash}")
    return ("\n".join(lines) + "\n").encode()


def journal_bytes(transaction: str, stage: str, records: dict[str, tuple[int, int, int, str]]) -> bytes:
    lines = [f"forza-motorsport-linux-journal-v1\t{transaction}\t{stage}"]
    for relative in PAYLOADS:
        device, inode, mode, file_hash = records[relative]
        lines.append(f"{relative}\t{device}\t{inode}\t{mode:o}\t{file_hash}")
    return ("\n".join(lines) + "\n").encode()


def parse_journal(data: bytes) -> tuple[str, str, dict[str, tuple[int, int, int, str]]]:
    lines = data.decode("utf-8").splitlines()
    header = lines[0].split("\t") if lines else []
    if len(header) != 3 or header[0] != "forza-motorsport-linux-journal-v1":
        raise SecureFilesError("unrecognized transaction journal")
    transaction, stage = header[1:]
    relative_parts(transaction)
    relative_parts(stage)
    records: dict[str, tuple[int, int, int, str]] = {}
    for line in lines[1:]:
        fields = line.split("\t")
        if len(fields) != 5 or fields[0] not in PAYLOADS or fields[0] in records:
            raise SecureFilesError("malformed transaction journal")
        relative, device, inode, mode, file_hash = fields
        if not all(value.isdigit() for value in (device, inode, mode)) or len(file_hash) != 64:
            raise SecureFilesError("malformed transaction journal")
        records[relative] = (int(device), int(inode), int(mode, 8), file_hash)
    if set(records) != set(PAYLOADS):
        raise SecureFilesError("transaction journal does not list every payload")
    return transaction, stage, records


def retire_stage(root_fd: int, stage: str, stage_info: os.stat_result | None, transaction: str) -> None:
    if stage_info is None:
        return
    try:
        current = os.stat(stage, dir_fd=root_fd, follow_symlinks=False)
    except FileNotFoundError:
        return
    if (current.st_dev, current.st_ino) != (stage_info.st_dev, stage_info.st_ino):
        print("warning: preserving substituted staging directory", file=sys.stderr)
        return
    retire_name(root_fd, stage, root_fd, transaction, "stage")


def recover_interrupted(root_fd: int) -> None:
    try:
        data, _, _ = read_root_file(root_fd, JOURNAL)
    except FileNotFoundError:
        return
    transaction, stage, records = parse_journal(data)
    try:
        manifest_data, _, _ = read_root_file(root_fd, MANIFEST)
        committed = current_matches(root_fd, parse_manifest(manifest_data))
    except (FileNotFoundError, OSError, SecureFilesError):
        committed = False
    if not committed:
        for relative, (device, inode, mode, file_hash) in records.items():
            try:
                parent_fd, leaf = open_parent(root_fd, relative, create=False)
                try:
                    quarantine_then_verify(parent_fd, leaf, relative, mode, file_hash, (device, inode), root_fd, transaction)
                finally:
                    os.close(parent_fd)
            except (FileNotFoundError, OSError, SecureFilesError):
                continue
    journal_parent, journal_leaf = open_parent(root_fd, JOURNAL, create=False)
    try:
        retire_name(journal_parent, journal_leaf, root_fd, transaction, "journal")
    finally:
        os.close(journal_parent)
    try:
        stage_info = os.stat(stage, dir_fd=root_fd, follow_symlinks=False)
    except FileNotFoundError:
        stage_info = None
    retire_stage(root_fd, stage, stage_info, transaction)


def stage_name(root_fd: int) -> tuple[str, int]:
    for _ in range(100):
        name = f".forza-install-{secrets.token_hex(12)}"
        try:
            os.mkdir(name, 0o700, dir_fd=root_fd)
        except FileExistsError:
            continue
        return name, os.open(name, DIRECTORY, dir_fd=root_fd)
    raise SecureFilesError("cannot create unique staging directory")


def stage_file(stage_fd: int, relative: str, data: bytes, mode: int) -> None:
    parent_fd, leaf = open_parent(stage_fd, relative, create=True)
    try:
        write_new_at(parent_fd, leaf, data, mode)
    finally:
        os.close(parent_fd)


def publish(stage_fd: int, root_fd: int, relative: str) -> os.stat_result:
    source_parent, leaf = open_parent(stage_fd, relative, create=False)
    destination_parent, destination_leaf = open_parent(root_fd, relative, create=True)
    try:
        rename_noreplace(source_parent, leaf, destination_parent, destination_leaf)
        info = os.stat(destination_leaf, dir_fd=destination_parent, follow_symlinks=False)
        if not stat.S_ISREG(info.st_mode):
            raise SecureFilesError(f"published destination is not regular: {relative}")
        return info
    finally:
        os.close(source_parent)
        os.close(destination_parent)


def quarantine_name(prefix: str) -> str:
    return f".{prefix}-{secrets.token_hex(12)}"


def preserve_quarantine(parent_fd: int, quarantine: str, leaf: str, root_fd: int, transaction: str, relative: str) -> None:
    try:
        rename_noreplace(parent_fd, quarantine, parent_fd, leaf)
        print(f"warning: preserving replaced file: {relative}", file=sys.stderr)
        return
    except OSError as error:
        if error.errno != errno.EEXIST:
            raise
    retire_name(parent_fd, quarantine, root_fd, transaction, "replaced")
    print(
        f"warning: preserving replaced file in project recovery: {relative}",
        file=sys.stderr,
    )


def quarantine_then_verify(
    parent_fd: int,
    leaf: str,
    relative: str,
    expected_mode: int,
    expected_hash: str,
    expected_identity: tuple[int, int] | None,
    root_fd: int,
    transaction: str,
) -> bool:
    quarantine = quarantine_name("forza-quarantine")
    try:
        rename_noreplace(parent_fd, leaf, parent_fd, quarantine)
    except FileNotFoundError:
        return False
    try:
        data, mode, info = read_regular_at(parent_fd, quarantine)
        matches = mode == expected_mode and digest(data) == expected_hash
        if expected_identity is not None:
            matches = matches and (info.st_dev, info.st_ino) == expected_identity
        if matches:
            retire_name(parent_fd, quarantine, root_fd, transaction, "owned")
            return True
        preserve_quarantine(parent_fd, quarantine, leaf, root_fd, transaction, relative)
        return False
    except Exception:
        try:
            preserve_quarantine(parent_fd, quarantine, leaf, root_fd, transaction, relative)
        except (FileNotFoundError, OSError, SecureFilesError):
            print(f"warning: preserving quarantined file: {relative}", file=sys.stderr)
        raise


def rollback(root_fd: int, published: Iterable[tuple[str, int, int, int, str]], transaction: str) -> None:
    for relative, device, inode, mode, expected_hash in reversed(tuple(published)):
        try:
            parent_fd, leaf = open_parent(root_fd, relative, create=False)
            try:
                removed = quarantine_then_verify(
                    parent_fd,
                    leaf,
                    relative,
                    mode,
                    expected_hash,
                    (device, inode),
                    root_fd,
                    transaction,
                )
                if not removed:
                    print(f"warning: preserving replaced file during rollback: {relative}", file=sys.stderr)
            finally:
                os.close(parent_fd)
        except (FileNotFoundError, OSError, SecureFilesError):
            print(f"warning: preserving unavailable file during rollback: {relative}", file=sys.stderr)


def numeric_environment(name: str) -> int:
    value = os.environ.get(name, "")
    if not value:
        return 0
    if not value.isdigit():
        raise SecureFilesError(f"{name} must be numeric")
    return int(value)


def install(root: str, sources: dict[str, str], explicit_root: bool) -> None:
    root_fd = open_absolute_directory(root)
    stage_fd = -1
    stage = ""
    stage_info: os.stat_result | None = None
    transaction = secrets.token_hex(12)
    published: list[tuple[str, int, int, int, str]] = []
    try:
        recover_interrupted(root_fd)
        payload_data: dict[str, tuple[bytes, int]] = {}
        records: dict[str, tuple[int, str]] = {}
        for relative in PAYLOADS:
            source = sources[relative]
            executable = relative.startswith(".local/bin/") or "/libexec/" in relative
            data, mode = read_regular_absolute(source, executable=executable)
            payload_data[relative] = (data, mode)
            records[relative] = (mode, digest(data))
        staged_manifest = manifest_bytes(records)

        try:
            installed_manifest, _, _ = read_root_file(root_fd, MANIFEST)
        except FileNotFoundError:
            installed_manifest = None
        destinations_exist = False
        for relative in PAYLOADS:
            try:
                read_root_file(root_fd, relative)
                destinations_exist = True
            except FileNotFoundError:
                pass
        if installed_manifest is None:
            if destinations_exist:
                raise SecureFilesError("refusing pre-existing destination without install manifest")
            owned = False
        else:
            existing_records = parse_manifest(installed_manifest)
            owned = installed_manifest == staged_manifest and current_matches(root_fd, existing_records)
            if not owned:
                raise SecureFilesError("refusing destination not proven by a matching install manifest")
        if owned:
            return

        stage, stage_fd = stage_name(root_fd)
        stage_info = os.fstat(stage_fd)
        journal_records: dict[str, tuple[int, int, int, str]] = {}
        for relative in PAYLOADS:
            data, mode = payload_data[relative]
            stage_file(stage_fd, relative, data, mode)
            _, _, info = read_root_file(stage_fd, relative)
            journal_records[relative] = (info.st_dev, info.st_ino, mode, digest(data))
        stage_file(stage_fd, MANIFEST, staged_manifest, 0o600)
        journal_parent, journal_leaf = open_parent(root_fd, JOURNAL, create=True)
        try:
            write_new_at(journal_parent, journal_leaf, journal_bytes(transaction, stage, journal_records), 0o600)
            os.fsync(journal_parent)
        finally:
            os.close(journal_parent)

        fail_after = numeric_environment("FORZA_INSTALL_FAIL_AFTER_PUBLISH") if explicit_root else 0
        pause_after = numeric_environment("FORZA_INSTALL_PAUSE_AFTER_PUBLISH") if explicit_root else 0
        pause_before = numeric_environment("FORZA_INSTALL_PAUSE_BEFORE_PUBLISH") if explicit_root else 0
        for count, relative in enumerate(PAYLOADS, start=1):
            if pause_before == count:
                time.sleep(0.5)
            info = publish(stage_fd, root_fd, relative)
            data, mode, _ = read_root_file(root_fd, relative)
            published.append((relative, info.st_dev, info.st_ino, mode, digest(data)))
            if pause_after == count:
                time.sleep(0.5)
            if explicit_root and numeric_environment("FORZA_INSTALL_CRASH_AFTER_PUBLISH") == count:
                os._exit(99)
            if fail_after == count:
                raise SecureFilesError("simulated publish interruption")
        if explicit_root and os.environ.get("FORZA_INSTALL_FAIL_BEFORE_MANIFEST") == "1":
            raise SecureFilesError("simulated failure before manifest publication")
        publish(stage_fd, root_fd, MANIFEST)
        journal_parent, journal_leaf = open_parent(root_fd, JOURNAL, create=False)
        try:
            retire_name(journal_parent, journal_leaf, root_fd, transaction, "journal")
        finally:
            os.close(journal_parent)
    except Exception:
        rollback(root_fd, published, transaction)
        raise
    finally:
        if stage_fd >= 0:
            os.close(stage_fd)
        if stage:
            if explicit_root and numeric_environment("FORZA_INSTALL_PAUSE_BEFORE_STAGE_RETIRE") == 1:
                time.sleep(0.5)
            retire_stage(root_fd, stage, stage_info, transaction)
        os.close(root_fd)


def uninstall(root: str) -> bool:
    root_fd = open_absolute_directory(root)
    transaction = secrets.token_hex(12)
    try:
        recover_interrupted(root_fd)
        try:
            data, _, manifest_info = read_root_file(root_fd, MANIFEST)
        except FileNotFoundError:
            return False
        records = parse_manifest(data)
        for relative in PAYLOADS:
            parent_fd, leaf = open_parent(root_fd, relative, create=False)
            os.close(parent_fd)
            relative_parts(relative)
        for relative, (mode, expected_hash) in records.items():
            try:
                parent_fd, leaf = open_parent(root_fd, relative, create=False)
                try:
                    if not quarantine_then_verify(
                        parent_fd, leaf, relative, mode, expected_hash, None, root_fd, transaction
                    ):
                        print(f"warning: preserving modified file: {relative}", file=sys.stderr)
                finally:
                    os.close(parent_fd)
            except FileNotFoundError:
                pass
        parent_fd, leaf = open_parent(root_fd, MANIFEST, create=False)
        try:
            removed = quarantine_then_verify(
                parent_fd,
                leaf,
                MANIFEST,
                stat.S_IMODE(manifest_info.st_mode),
                digest(data),
                (manifest_info.st_dev, manifest_info.st_ino),
                root_fd,
                transaction,
            )
            if not removed:
                raise SecureFilesError("install manifest changed during uninstall")
        finally:
            os.close(parent_fd)
        return True
    finally:
        os.close(root_fd)


def source_arguments(values: list[str]) -> dict[str, str]:
    sources: dict[str, str] = {}
    for value in values:
        relative, separator, source = value.partition("=")
        if not separator or relative not in PAYLOADS or relative in sources:
            raise SecureFilesError("invalid source mapping")
        sources[relative] = source
    if set(sources) != set(PAYLOADS):
        raise SecureFilesError("source mapping does not cover every payload")
    return sources


def main() -> int:
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    install_parser = subparsers.add_parser("install")
    install_parser.add_argument("--root", required=True)
    install_parser.add_argument("--source", action="append", required=True)
    install_parser.add_argument("--explicit-root", action="store_true")
    uninstall_parser = subparsers.add_parser("uninstall")
    uninstall_parser.add_argument("--root", required=True)
    args = parser.parse_args()
    try:
        if args.command == "install":
            install(args.root, source_arguments(args.source), args.explicit_root)
        elif not uninstall(args.root):
            return 3
    except (OSError, SecureFilesError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
