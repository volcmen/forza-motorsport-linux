#!/usr/bin/env python3
"""Fail-closed, reversible patches for one reviewed Forza compatibility build."""

from __future__ import annotations

import argparse
import ctypes
import errno
import hashlib
import json
import os
import secrets
import stat
import sys
import tempfile
import tomllib
from collections.abc import Callable, Mapping, Sequence
from dataclasses import dataclass
from datetime import UTC, datetime
from enum import Enum
from pathlib import Path, PurePosixPath

APP_ID = "2440510"
COMPATIBILITY_TOOL = "GE-Proton11-3-FM"
DEFAULT_MANIFEST = Path(__file__).parents[1] / "manifests" / "supported-builds.toml"
DIRECTORY = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
RENAME_NOREPLACE = 1
RENAME_EXCHANGE = 2
TOKEN_BYTES = 12
LIBC = ctypes.CDLL(None, use_errno=True)
RENAMEAT2 = getattr(LIBC, "renameat2", None)
if RENAMEAT2 is not None:
    RENAMEAT2.argtypes = (
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    )
    RENAMEAT2.restype = ctypes.c_int


class PatcherError(RuntimeError):
    """Base class for a refused patch operation."""


class TargetMissing(PatcherError):
    """Raised when an explicitly requested target is absent."""


class UnknownBuild(PatcherError):
    """Raised when a target or backup does not match its reviewed digest."""


class _PublicationConflict(UnknownBuild):
    """A publication race whose displaced target was handled safely."""

    def __init__(self, message: str, *, target_restored: bool):
        super().__init__(message)
        self.target_restored = target_restored


class PatchMismatch(PatcherError):
    """Raised when reviewed edit bytes are not present in an accepted target."""


class ManifestError(PatcherError):
    """Raised when a patch or backup manifest is malformed or unsafe."""


class RollbackError(PatcherError):
    """Raised when a transaction rollback cannot safely complete."""


class TransactionError(PatcherError):
    """Preserves an operation failure alongside its rollback failure."""

    def __init__(self, primary: Exception, rollback: Exception):
        super().__init__(f"transaction failed: {primary}; rollback failed: {rollback}")
        self.primary = primary
        self.rollback = rollback


@dataclass(frozen=True)
class Edit:
    offset: int
    before: bytes
    after: bytes


@dataclass(frozen=True)
class PatchSpec:
    name: str
    file: str
    original_sha256: str
    patched_sha256: str
    edits: tuple[Edit, ...]


class PatchState(Enum):
    ORIGINAL = "original"
    PATCHED = "patched"
    UNKNOWN = "unknown"


@dataclass(frozen=True)
class PatchResult:
    before: str
    after: str
    backup: Path


@dataclass(frozen=True)
class ForzaPatchResult:
    backup_manifest: Path
    results: tuple[PatchResult, ...]


@dataclass
class RollbackEntry:
    path: Path
    backup: Path
    spec: PatchSpec
    mode: int
    active: bool = True


def _absolute_lexical(path: Path) -> Path:
    return Path(os.path.abspath(os.fspath(path)))


def _open_parent_nofollow(path: Path) -> tuple[int, str]:
    absolute = _absolute_lexical(path)
    parts = absolute.parts
    if len(parts) < 2:
        raise PatcherError(f"target path has no basename: {path}")
    descriptor = os.open("/", DIRECTORY)
    try:
        for part in parts[1:-1]:
            next_descriptor = os.open(part, DIRECTORY, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = next_descriptor
        return descriptor, parts[-1]
    except Exception:
        os.close(descriptor)
        raise


def _read_regular_at(
    parent_fd: int, leaf: str, label: str
) -> tuple[bytes, int, os.stat_result]:
    try:
        descriptor = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=parent_fd)
    except FileNotFoundError as error:
        raise TargetMissing(f"{label} does not exist: {leaf}") from error
    except OSError as error:
        if error.errno in {errno.ELOOP, errno.ENOTDIR}:
            raise PatcherError(f"{label} path contains a symlink or non-directory: {leaf}") from error
        raise
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode):
            raise PatcherError(f"{label} is not a regular file: {leaf}")
        chunks: list[bytes] = []
        while block := os.read(descriptor, 1024 * 1024):
            chunks.append(block)
        return b"".join(chunks), stat.S_IMODE(info.st_mode), info
    finally:
        os.close(descriptor)


def _read_regular_path(path: Path, label: str) -> tuple[bytes, int, os.stat_result]:
    try:
        parent_fd, leaf = _open_parent_nofollow(path)
    except FileNotFoundError as error:
        raise TargetMissing(f"{label} does not exist: {path}") from error
    except OSError as error:
        if error.errno in {errno.ELOOP, errno.ENOTDIR}:
            raise PatcherError(f"{label} path contains a symlink or non-directory: {path}") from error
        raise
    try:
        return _read_regular_at(parent_fd, leaf, label)
    finally:
        os.close(parent_fd)


def sha256(path: Path) -> str:
    data, _, _ = _read_regular_path(path, "target")
    return hashlib.sha256(data).hexdigest()


def inspect_target(path: Path, spec: PatchSpec) -> PatchState:
    digest = sha256(path)
    if digest == spec.original_sha256:
        return PatchState.ORIGINAL
    if digest == spec.patched_sha256:
        return PatchState.PATCHED
    return PatchState.UNKNOWN


def load_specs(manifest_path: Path) -> dict[str, PatchSpec]:
    _require_regular_file(manifest_path, "manifest")
    with manifest_path.open("rb") as stream:
        document = tomllib.load(stream)
    records = document.get("patches")
    if not isinstance(records, list):
        raise ManifestError("manifest patches must be an array")

    specs: dict[str, PatchSpec] = {}
    for record in records:
        spec = _parse_spec(record)
        if spec.file in specs:
            raise ManifestError(f"duplicate patch file: {spec.file}")
        specs[spec.file] = spec
    if not specs:
        raise ManifestError("manifest contains no patches")
    return specs


def resolve_forza_targets(steam_root: Path) -> list[Path]:
    tool_root = (
        steam_root
        / "compatibilitytools.d"
        / COMPATIBILITY_TOOL
        / "files"
        / "lib"
        / "wine"
        / "x86_64-windows"
    )
    prefix_root = steam_root / "steamapps" / "compatdata" / APP_ID / "pfx" / "drive_c"
    return [
        tool_root / "windows.gaming.input.dll",
        prefix_root / "windows" / "system32" / "windows.gaming.input.dll",
        tool_root / "mountmgr.sys",
        prefix_root / "windows" / "system32" / "drivers" / "mountmgr.sys",
    ]


def apply_target(
    path: Path,
    spec: PatchSpec,
    backup_root: Path,
    on_backup: Callable[[RollbackEntry], None] | None = None,
) -> PatchResult:
    try:
        parent_fd, leaf = _open_parent_nofollow(path)
    except FileNotFoundError as error:
        raise TargetMissing(f"target does not exist: {path}") from error
    try:
        original, mode, target_info = _read_regular_at(parent_fd, leaf, "target")
        before = hashlib.sha256(original).hexdigest()
        if before != spec.original_sha256:
            raise UnknownBuild(f"target is not the reviewed original build: {path}")
        patched = _apply_edits(original, spec)
        if hashlib.sha256(patched).hexdigest() != spec.patched_sha256:
            raise PatchMismatch(f"patch result does not match reviewed digest: {path}")

        _validate_backup_root_for_target(path, backup_root)
        backup_root.mkdir(parents=True, exist_ok=True)
        backup = _write_exclusive_backup(
            backup_root, path.name, spec.original_sha256, original, mode
        )
        if sha256(backup) != spec.original_sha256:
            raise PatchMismatch(f"backup verification failed: {backup}")
        rollback = RollbackEntry(path, backup, spec, mode, active=False)
        if on_backup is not None:
            on_backup(rollback)
        rollback.active = True
        try:
            published_identity = _atomic_replace_at(
                parent_fd,
                leaf,
                path,
                patched,
                mode,
                (target_info.st_dev, target_info.st_ino),
                spec.original_sha256,
            )
            final, final_mode, final_info = _read_regular_at(parent_fd, leaf, "target")
            after = hashlib.sha256(final).hexdigest()
            if (
                (final_info.st_dev, final_info.st_ino) != published_identity
                or final_mode != mode
                or after != spec.patched_sha256
            ):
                raise PatchMismatch(f"patched target verification failed: {path}")
        except Exception as primary:
            if isinstance(primary, _PublicationConflict) and primary.target_restored:
                rollback.active = False
            else:
                try:
                    state = inspect_target(path, spec)
                except (OSError, PatcherError):
                    state = None
                if state in {PatchState.ORIGINAL, PatchState.UNKNOWN}:
                    rollback.active = False
            if rollback.active:
                try:
                    _rollback_entries((rollback,))
                except RollbackError as rollback_error:
                    raise TransactionError(primary, rollback_error) from primary
            raise
        return PatchResult(before=before, after=after, backup=backup)
    finally:
        os.close(parent_fd)


def restore_target(path: Path, backup: Path, spec: PatchSpec) -> PatchResult:
    parent_fd, leaf = _open_parent_nofollow(path)
    try:
        current, mode, target_info = _read_regular_at(parent_fd, leaf, "target")
        before = hashlib.sha256(current).hexdigest()
        if before != spec.patched_sha256:
            raise UnknownBuild(f"target is not the reviewed patched build: {path}")
        original, _, _ = _read_regular_path(backup, "backup")
        if hashlib.sha256(original).hexdigest() != spec.original_sha256:
            raise UnknownBuild(f"backup is not the reviewed original build: {backup}")
        restored_identity = _atomic_replace_at(
            parent_fd,
            leaf,
            path,
            original,
            mode,
            (target_info.st_dev, target_info.st_ino),
            spec.patched_sha256,
        )
        restored, restored_mode, restored_info = _read_regular_at(parent_fd, leaf, "target")
        after = hashlib.sha256(restored).hexdigest()
        if (
            (restored_info.st_dev, restored_info.st_ino) != restored_identity
            or restored_mode != mode
            or after != spec.original_sha256
        ):
            raise PatchMismatch(f"restored target verification failed: {path}")
        return PatchResult(before=before, after=after, backup=backup)
    finally:
        os.close(parent_fd)


def apply_forza(
    steam_root: Path, specs: Mapping[str, PatchSpec], backup_root: Path
) -> ForzaPatchResult:
    _validate_backup_root(steam_root / "compatibilitytools.d", backup_root)
    targets = resolve_forza_targets(steam_root)
    pairs = [(target, _spec_for_target(target, specs)) for target in targets]
    states = [(target, spec, inspect_target(target, spec)) for target, spec in pairs]
    unknown = [target for target, _, state in states if state is PatchState.UNKNOWN]
    if unknown:
        raise UnknownBuild(f"refusing transaction; unknown target: {unknown[0]}")
    if all(state is PatchState.PATCHED for _, _, state in states):
        raise PatcherError("all targets are already patched; no backup manifest was written")
    if any(state is PatchState.PATCHED for _, _, state in states):
        raise PatcherError("refusing mixed target states")

    rollback_entries: list[RollbackEntry] = []
    results: list[PatchResult] = []
    try:
        for target, spec, _ in states:
            results.append(
                apply_target(target, spec, backup_root, on_backup=rollback_entries.append)
            )
        manifest = _write_backup_manifest(steam_root, backup_root, rollback_entries)
    except Exception as primary:
        try:
            _rollback_entries(rollback_entries)
        except RollbackError as rollback_error:
            raise TransactionError(primary, rollback_error) from primary
        raise
    return ForzaPatchResult(manifest, tuple(results))


def restore_forza(
    steam_root: Path, backup_manifest: Path, specs: Mapping[str, PatchSpec]
) -> tuple[PatchResult, ...]:
    _require_regular_file(backup_manifest, "backup manifest")
    try:
        record = json.loads(backup_manifest.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise ManifestError(f"cannot read backup manifest: {backup_manifest}") from error
    entries = _backup_entries(steam_root, backup_manifest.parent, record, specs)

    for target, backup, spec in entries:
        if inspect_target(target, spec) is not PatchState.PATCHED:
            raise UnknownBuild(f"refusing restore; target is not patched: {target}")
        _require_regular_file(backup, "backup")
        if sha256(backup) != spec.original_sha256:
            raise UnknownBuild(f"refusing restore; backup is not original: {backup}")

    return tuple(restore_target(target, backup, spec) for target, backup, spec in entries)


def _parse_spec(record: object) -> PatchSpec:
    if not isinstance(record, dict):
        raise ManifestError("patch record must be a table")
    try:
        name = record["name"]
        file = record["file"]
        original = record["original_sha256"]
        patched = record["patched_sha256"]
        edits = record["edits"]
    except KeyError as error:
        raise ManifestError(f"patch record missing {error.args[0]}") from error
    if not all(isinstance(value, str) for value in (name, file, original, patched)):
        raise ManifestError("patch names and hashes must be strings")
    if Path(file).name != file:
        raise ManifestError(f"patch file must be a basename: {file}")
    _validate_digest(original, "original_sha256")
    _validate_digest(patched, "patched_sha256")
    if not isinstance(edits, list) or not edits:
        raise ManifestError("patch edits must be a nonempty array")
    return PatchSpec(name, file, original, patched, tuple(_parse_edit(edit) for edit in edits))


def _parse_edit(record: object) -> Edit:
    if not isinstance(record, dict):
        raise ManifestError("edit must be a table")
    offset = record.get("offset")
    before = record.get("before")
    after = record.get("after")
    if not isinstance(offset, int) or offset < 0:
        raise ManifestError("edit offset must be a nonnegative integer")
    if not isinstance(before, str) or not isinstance(after, str):
        raise ManifestError("edit bytes must be hexadecimal strings")
    try:
        before_bytes = bytes.fromhex(before)
        after_bytes = bytes.fromhex(after)
    except ValueError as error:
        raise ManifestError("edit bytes must be hexadecimal strings") from error
    if not before_bytes or len(before_bytes) != len(after_bytes):
        raise ManifestError("edit replacements must be nonempty and equal length")
    return Edit(offset, before_bytes, after_bytes)


def _apply_edits(original: bytes, spec: PatchSpec) -> bytes:
    patched = bytearray(original)
    for edit in spec.edits:
        end = edit.offset + len(edit.before)
        if end > len(original) or original[edit.offset:end] != edit.before:
            raise PatchMismatch(f"reviewed bytes absent for {spec.name} at 0x{edit.offset:x}")
        patched[edit.offset:end] = edit.after
    return bytes(patched)


def _require_regular_file(path: Path, label: str) -> None:
    _read_regular_path(path, label)


def _renameat2(
    source_fd: int,
    source: str,
    destination_fd: int,
    destination: str,
    flags: int,
) -> None:
    if RENAMEAT2 is None:
        raise PatcherError("renameat2 is unavailable")
    result = RENAMEAT2(
        source_fd,
        os.fsencode(source),
        destination_fd,
        os.fsencode(destination),
        flags,
    )
    if result == 0:
        return
    error_number = ctypes.get_errno()
    if error_number in {errno.ENOSYS, errno.EINVAL}:
        raise PatcherError("required renameat2 operation is unavailable")
    raise OSError(error_number, os.strerror(error_number), destination)


def _random_name(parent_fd: int, leaf: str, data: bytes, mode: int) -> tuple[str, tuple[int, int]]:
    for _ in range(100):
        temporary = f".{leaf}.forza-{secrets.token_hex(TOKEN_BYTES)}"
        try:
            descriptor = os.open(
                temporary,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                mode,
                dir_fd=parent_fd,
            )
        except FileExistsError:
            continue
        try:
            view = memoryview(data)
            while view:
                written = os.write(descriptor, view)
                view = view[written:]
            os.fchmod(descriptor, mode)
            os.fsync(descriptor)
            info = os.fstat(descriptor)
            return temporary, (info.st_dev, info.st_ino)
        except Exception:
            try:
                os.unlink(temporary, dir_fd=parent_fd)
            except FileNotFoundError:
                pass
            raise
        finally:
            os.close(descriptor)
    raise PatcherError("could not reserve a target staging name")


def _restore_displaced_after_conflict(
    parent_fd: int,
    leaf: str,
    displaced: str,
    display_path: Path,
) -> bool:
    try:
        _renameat2(parent_fd, leaf, parent_fd, displaced, RENAME_EXCHANGE)
    except FileNotFoundError:
        try:
            _renameat2(parent_fd, displaced, parent_fd, leaf, RENAME_NOREPLACE)
        except FileNotFoundError:
            return False
        except (OSError, PatcherError) as error:
            if isinstance(error, OSError) and error.errno == errno.EEXIST:
                _preserve_conflict_object(
                    parent_fd, leaf, displaced, display_path, "displaced-target"
                )
                return False
            recovered_path = _preserve_conflict_object(
                parent_fd, leaf, displaced, display_path, "displaced-target"
            )
            if recovered_path is None:
                displaced_status = (
                    f"displaced target no longer exists at "
                    f"{display_path.with_name(displaced)}"
                )
            else:
                displaced_status = f"displaced target preserved at {recovered_path}"
            raise RollbackError(
                f"fallback restoration failed for {display_path}; "
                f"{displaced_status}; public target remains at {display_path}"
            ) from error
        try:
            os.fsync(parent_fd)
        except OSError as error:
            raise RollbackError(
                f"displaced target restored at {display_path}; directory fsync failed"
            ) from error
        return True
    except (OSError, PatcherError) as error:
        recovered_path = _preserve_conflict_object(
            parent_fd, leaf, displaced, display_path, "displaced-target"
        )
        if recovered_path is None:
            displaced_status = (
                f"displaced target no longer exists at "
                f"{display_path.with_name(displaced)}"
            )
        else:
            displaced_status = f"displaced target preserved at {recovered_path}"
        raise RollbackError(
            f"restorative exchange failed for {display_path}; "
            f"{displaced_status}; "
            f"published staging remains at {display_path}"
        ) from error

    try:
        _preserve_conflict_object(
            parent_fd, leaf, displaced, display_path, "publication-conflict"
        )
    except RollbackError as error:
        raise RollbackError(
            f"displaced target restored at {display_path}; {error}"
        ) from error
    return True


def _preserve_conflict_object(
    parent_fd: int,
    leaf: str,
    source: str,
    display_path: Path,
    label: str,
) -> Path | None:
    source_path = display_path.with_name(source)
    for suffix in range(100):
        ending = "" if suffix == 0 else f".{suffix}"
        recovery = f".{leaf}.forza-recovery-{label}{ending}"
        recovered_path = display_path.with_name(recovery)
        try:
            _renameat2(parent_fd, source, parent_fd, recovery, RENAME_NOREPLACE)
        except FileNotFoundError:
            return None
        except (OSError, PatcherError) as error:
            if isinstance(error, OSError) and error.errno == errno.EEXIST:
                continue
            raise RollbackError(
                f"concurrent object remains at {source_path}; recovery rename failed"
            ) from error
        try:
            os.fsync(parent_fd)
        except OSError as error:
            raise RollbackError(
                f"concurrent object preserved at {recovered_path}; directory fsync failed"
            ) from error
        print(f"warning: preserved concurrent object at {recovered_path}", file=sys.stderr)
        return recovered_path
    raise RollbackError(
        f"concurrent object remains at {source_path}; cannot reserve recovery name"
    )


def _atomic_replace_at(
    parent_fd: int,
    leaf: str,
    display_path: Path,
    data: bytes,
    mode: int,
    expected_identity: tuple[int, int],
    expected_hash: str,
) -> tuple[int, int]:
    temporary, published_identity = _random_name(parent_fd, leaf, data, mode)
    exchanged = False
    try:
        _renameat2(parent_fd, temporary, parent_fd, leaf, RENAME_EXCHANGE)
        exchanged = True
        try:
            os.fsync(parent_fd)
        except OSError as error:
            restored = _restore_displaced_after_conflict(
                parent_fd, leaf, temporary, display_path
            )
            exchanged = False
            temporary = ""
            raise _PublicationConflict(
                f"target publication durability failed: {display_path}",
                target_restored=restored,
            ) from error
        try:
            displaced, displaced_mode, displaced_info = _read_regular_at(
                parent_fd, temporary, "displaced target"
            )
        except (OSError, PatcherError) as error:
            restored = _restore_displaced_after_conflict(
                parent_fd, leaf, temporary, display_path
            )
            exchanged = False
            temporary = ""
            raise _PublicationConflict(
                f"target changed during publication: {display_path}",
                target_restored=restored,
            ) from error
        if (
            (displaced_info.st_dev, displaced_info.st_ino) != expected_identity
            or displaced_mode != mode
            or hashlib.sha256(displaced).hexdigest() != expected_hash
        ):
            restored = _restore_displaced_after_conflict(
                parent_fd, leaf, temporary, display_path
            )
            exchanged = False
            temporary = ""
            raise _PublicationConflict(
                f"target changed during publication: {display_path}",
                target_restored=restored,
            )
        _preserve_conflict_object(
            parent_fd, leaf, temporary, display_path, "publication-success"
        )
        temporary = ""
        exchanged = False
        return published_identity
    finally:
        if not exchanged and temporary:
            _preserve_conflict_object(
                parent_fd, leaf, temporary, display_path, "unpublished-staging"
            )


def _fsync_directory(directory: Path) -> None:
    descriptor = os.open(directory, DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _resolved_for_scope(path: Path) -> Path:
    try:
        return _absolute_lexical(path).resolve(strict=False)
    except (OSError, RuntimeError) as error:
        raise PatcherError(f"cannot resolve path safely: {path}") from error


def _validate_backup_root(compatibility_tools_root: Path, backup_root: Path) -> None:
    compatibility_tools = _resolved_for_scope(compatibility_tools_root)
    backup = _resolved_for_scope(backup_root)
    if backup == compatibility_tools or compatibility_tools in backup.parents:
        raise PatcherError("backup root must resolve outside compatibilitytools.d")


def _validate_backup_root_for_target(path: Path, backup_root: Path) -> None:
    if "compatibilitytools.d" in _resolved_for_scope(backup_root).parts:
        raise PatcherError("backup root must resolve outside compatibilitytools.d")
    absolute = _absolute_lexical(path)
    try:
        marker = absolute.parts.index("compatibilitytools.d")
    except ValueError:
        return
    compatibility_tools = Path(*absolute.parts[: marker + 1])
    _validate_backup_root(compatibility_tools, backup_root)


def _atomic_create_new(path: Path, data: bytes, mode: int) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fchmod(stream.fileno(), mode)
            os.fsync(stream.fileno())
        os.link(temporary, path)
        _fsync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def _write_exclusive_backup(
    backup_root: Path, name: str, original_hash: str, data: bytes, mode: int
) -> Path:
    timestamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")
    for suffix in range(sys.maxsize):
        ending = "" if suffix == 0 else f".{suffix}"
        candidate = backup_root / f"{timestamp}-{original_hash}-{name}{ending}"
        try:
            _atomic_create_new(candidate, data, mode)
        except FileExistsError:
            continue
        return candidate
    raise PatcherError("could not reserve a unique backup name")


def _spec_for_target(target: Path, specs: Mapping[str, PatchSpec]) -> PatchSpec:
    try:
        return specs[target.name]
    except KeyError as error:
        raise ManifestError(f"manifest has no patch for {target.name}") from error


def _write_backup_manifest(
    steam_root: Path,
    backup_root: Path,
    applied: Sequence[RollbackEntry],
) -> Path:
    entries = []
    for entry in applied:
        entries.append(
            {
                "target": entry.path.relative_to(steam_root).as_posix(),
                "file": entry.spec.file,
                "original_sha256": entry.spec.original_sha256,
                "patched_sha256": entry.spec.patched_sha256,
                "backup": entry.backup.relative_to(backup_root).as_posix(),
            }
        )
    document = json.dumps({"version": 1, "targets": entries}, indent=2, sort_keys=True)
    timestamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")
    data = (document + "\n").encode()
    for suffix in range(sys.maxsize):
        ending = "" if suffix == 0 else f".{suffix}"
        manifest = backup_root / f"forza-patch-{timestamp}{ending}.json"
        try:
            _atomic_create_new(manifest, data, 0o600)
        except FileExistsError:
            continue
        return manifest
    raise PatcherError("could not reserve a unique backup manifest name")


def _rollback_entries(entries: Sequence[RollbackEntry]) -> None:
    active = []
    preflight_errors = []
    for entry in entries:
        if not entry.active:
            continue
        try:
            state = inspect_target(entry.path, entry.spec)
            if state is PatchState.ORIGINAL:
                entry.active = False
                continue
            if state is not PatchState.PATCHED:
                raise UnknownBuild(f"target is neither original nor patched: {entry.path}")
            if sha256(entry.backup) != entry.spec.original_sha256:
                raise UnknownBuild(f"backup is not original: {entry.backup}")
            active.append(entry)
        except (OSError, PatcherError) as error:
            preflight_errors.append(f"{entry.path}: {error}")
    if preflight_errors:
        raise RollbackError("rollback preflight failed: " + "; ".join(preflight_errors))

    restore_errors = []
    for entry in reversed(active):
        try:
            restore_target(entry.path, entry.backup, entry.spec)
            entry.active = False
        except (OSError, PatcherError) as error:
            restore_errors.append(f"{entry.path}: {error}")
    if restore_errors:
        raise RollbackError("rollback restore failed: " + "; ".join(restore_errors))


def _backup_entries(
    steam_root: Path,
    backup_root: Path,
    record: object,
    specs: Mapping[str, PatchSpec],
) -> list[tuple[Path, Path, PatchSpec]]:
    if not isinstance(record, dict) or record.get("version") != 1:
        raise ManifestError("backup manifest version is unsupported")
    entries = record.get("targets")
    if not isinstance(entries, list) or not entries:
        raise ManifestError("backup manifest contains no targets")
    allowed = {
        target.relative_to(steam_root).as_posix(): target
        for target in resolve_forza_targets(steam_root)
    }
    parsed: list[tuple[Path, Path, PatchSpec]] = []
    seen: set[str] = set()
    for entry in entries:
        if not isinstance(entry, dict):
            raise ManifestError("backup target entry must be an object")
        target_name = entry.get("target")
        backup_name = entry.get("backup")
        file_name = entry.get("file")
        if not all(isinstance(value, str) for value in (target_name, backup_name, file_name)):
            raise ManifestError("backup target entry is incomplete")
        if target_name in seen:
            raise ManifestError(f"backup manifest has a duplicate target: {target_name}")
        if target_name not in allowed:
            raise ManifestError(f"backup target is outside Forza scope: {target_name}")
        seen.add(target_name)
        target = allowed[target_name]
        if target.name != file_name:
            raise ManifestError(f"backup file does not match target: {target_name}")
        spec = _spec_for_target(target, specs)
        if (
            entry.get("original_sha256") != spec.original_sha256
            or entry.get("patched_sha256") != spec.patched_sha256
        ):
            raise ManifestError(f"backup hashes do not match manifest: {target_name}")
        backup = _safe_relative_path(backup_root, backup_name)
        parsed.append((target, backup, spec))
    if seen != set(allowed):
        raise ManifestError("backup manifest must contain exactly the four Forza targets")
    return parsed


def _safe_relative_path(root: Path, value: str) -> Path:
    candidate = PurePosixPath(value)
    if candidate.is_absolute() or ".." in candidate.parts:
        raise ManifestError(f"backup path is not relative: {value}")
    resolved_root = root.resolve(strict=True)
    current = root
    for part in candidate.parts:
        current /= part
        if current.is_symlink():
            raise ManifestError(f"backup path contains a symlink: {value}")
    resolved_candidate = current.resolve(strict=False)
    if resolved_root not in (resolved_candidate, *resolved_candidate.parents):
        raise ManifestError(f"backup path escapes its root: {value}")
    return current


def _validate_digest(value: str, field: str) -> None:
    if len(value) != 64 or any(character not in "0123456789abcdef" for character in value):
        raise ManifestError(f"{field} must be a lowercase SHA-256 digest")


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    inspect = commands.add_parser("inspect")
    inspect.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
    inspect.add_argument("--target", type=Path, required=True)
    apply = commands.add_parser("apply")
    apply.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
    apply.add_argument("--target", type=Path, required=True)
    apply.add_argument("--backup-root", type=Path, required=True)
    restore = commands.add_parser("restore")
    restore.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
    restore.add_argument("--target", type=Path, required=True)
    restore.add_argument("--backup", type=Path, required=True)
    apply_forza_command = commands.add_parser("apply-forza")
    apply_forza_command.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
    apply_forza_command.add_argument("--steam-root", type=Path, required=True)
    apply_forza_command.add_argument("--backup-root", type=Path, required=True)
    restore_forza_command = commands.add_parser("restore-forza")
    restore_forza_command.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
    restore_forza_command.add_argument("--steam-root", type=Path, required=True)
    restore_forza_command.add_argument("--backup-manifest", type=Path, required=True)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    arguments = _parser().parse_args(argv)
    try:
        specs = load_specs(arguments.manifest)
        if arguments.command == "inspect":
            _require_regular_file(arguments.target, "target")
            print(inspect_target(arguments.target, _spec_for_target(arguments.target, specs)).value)
        elif arguments.command == "apply":
            result = apply_target(
                arguments.target,
                _spec_for_target(arguments.target, specs),
                arguments.backup_root,
            )
            print(result.backup)
        elif arguments.command == "restore":
            restore_target(arguments.target, arguments.backup, _spec_for_target(arguments.target, specs))
        elif arguments.command == "apply-forza":
            result = apply_forza(arguments.steam_root, specs, arguments.backup_root)
            print(result.backup_manifest)
        elif arguments.command == "restore-forza":
            restore_forza(arguments.steam_root, arguments.backup_manifest, specs)
    except PatcherError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
