#!/usr/bin/env bash

set -u

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
HELPER="$ROOT/scripts/secure-user-files"
install_root=${FORZA_INSTALL_ROOT:-}

usage() {
    printf '%s\n' "usage: $0 [--root PATH]" >&2
    exit 64
}

while (($#)); do
    case "$1" in
        --root)
            (($# >= 2)) || usage
            install_root=$2
            shift 2
            ;;
        --help) usage ;;
        *) usage ;;
    esac
done

[[ -n $install_root ]] || install_root=${HOME:?HOME is required}
[[ $install_root == /* ]] || {
    printf '%s\n' 'error: root must be an absolute path' >&2
    exit 1
}

"$HELPER" uninstall --root "$install_root"
helper_status=$?
case "$helper_status" in
    0)
        systemctl --user daemon-reload || {
            printf '%s\n' 'error: cannot reload user systemd daemon' >&2
            exit 1
        }
        printf '%s\n' 'uninstalled Forza Motorsport Linux user integration'
        ;;
    3) exit 0 ;;
    *) exit "$helper_status" ;;
esac
